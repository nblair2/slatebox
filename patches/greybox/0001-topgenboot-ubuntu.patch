Ubuntu: named runs as user bind, and the (patched) topgen named.conf keeps its
data in /var/cache/bind/data, which must be private to the topgen.info node.
dovecot keeps the stderr it was started with open, and CORE waits for that
pipe to close before the session can finish starting.

--- a/share/maps/backbone.imn	2026-11-08 19:18:08.022654242 +0000
+++ b/share/maps/backbone.imn	2026-11-08 19:18:08.029833749 +0000
@@ -9786,7 +9786,7 @@
 	custom-config-id service:UserDefined
 	custom-command UserDefined
 	config {
-	dirs=('/var/log/nginx', '/var/named/data', '/var/lib/postfix', '/var/spool/postfix', '/var/spool/mail',)
+	dirs=('/var/log/nginx', '/var/cache/bind/data', '/var/lib/postfix', '/var/spool/postfix', '/var/spool/mail',)
 	files=('TopGenBoot.sh',)
 	cmdup=('sh TopGenBoot.sh start',)
 	cmddown=('sh TopGenBoot.sh stop',)
@@ -9809,13 +9809,13 @@
 	    /usr/sbin/ip addr add $i scope global dev lo
 	  done
 	  [ -s /var/lib/topgen/etc/named.conf ] && \
-	    /usr/sbin/named -u named -c /var/lib/topgen/etc/named.conf
+	    /usr/sbin/named -u bind -c /var/lib/topgen/etc/named.conf
 	  [ -s /var/lib/topgen/etc/nginx.conf ] && \
 	    /usr/sbin/nginx
 	  [ -s /var/lib/topgen/etc/postfix/main.cf ] && \
 	    /usr/sbin/postfix -c /var/lib/topgen/etc/postfix start
 	  [ -s /var/lib/topgen/etc/postfix/dovecot.conf ] && \
-	    /usr/sbin/dovecot -c /var/lib/topgen/etc/postfix/dovecot.conf
+	    /usr/sbin/dovecot -c /var/lib/topgen/etc/postfix/dovecot.conf </dev/null >/dev/null 2>&1
 	}
 
 	stop() {
