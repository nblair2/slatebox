diff --git a/sbin/topgen-scrape.sh b/sbin/topgen-scrape.sh
index d1fa8ff..ff74c7f 100755
--- a/sbin/topgen-scrape.sh
+++ b/sbin/topgen-scrape.sh
@@ -15,12 +15,18 @@ let VERBOSE=0
 # default recursive scrape depth:
 let DFL_DEPTH=1
 
+# if "yes", skip scraping and use the vhosts already present:
+NO_FETCH='no'
+
+# preset "<ip_addr fqdn>" entries (take precedence over DNS lookups):
+PRESET_HOSTS=''
+
 ###########################################################################
 ####    NO FURTHER USER-SERVICEABLE PARTS BEYOND THIS POINT !!!!!!!    ####
 ###########################################################################
 
 USAGE_BLURB="
-Usage: $0 [-s <site_list>] [-t <target_directory>]
+Usage: $0 [-s <site_list>] [-t <target_directory>] [-n] [-H <hosts_file>]
 
 The optional command line arguments are:
 
@@ -34,6 +40,12 @@ The optional command line arguments are:
                           are stored;
                           (default: $TOPGEN_VARLIB).
 
+    -n                    don't scrape; instead, (re-)process the vhosts
+                          already present in <target_directory>/vhosts.
+
+    -H <hosts_file>       take vhost IP addresses from a file containing
+                          <ip_addr fqdn> entries, falling back to DNS.
+
     -v                    increase verbosity level (may be used multiple times);
                           (default: $VERBOSE).
 
@@ -46,7 +58,7 @@ scraped vhost.
 
 # process command line options:
 OPTIND=1
-while getopts "s:t:vh?" OPT; do
+while getopts "s:t:nH:vh?" OPT; do
   case "$OPT" in
   s)
     TOPGEN_ORIG=$OPTARG
@@ -54,6 +66,12 @@ while getopts "s:t:vh?" OPT; do
   t)
     TOPGEN_VARLIB=$OPTARG
     ;;
+  n)
+    NO_FETCH='yes'
+    ;;
+  H)
+    PRESET_HOSTS=$(< "$OPTARG") || exit 1
+    ;;
   v)
     let VERBOSE++
     ;;
@@ -84,7 +102,7 @@ TOPGEN_VHOSTS="$TOPGEN_VARLIB/vhosts"
 TOPGEN_SITE="$TOPGEN_VHOSTS/topgen.info"
 
 # assert existence of required input files and target folders:
-[ -s "$TOPGEN_ORIG" -a \
+[ \( "$NO_FETCH" == "yes" -o -s "$TOPGEN_ORIG" \) -a \
   -d "$TOPGEN_VHOSTS" -a -d "$TOPGEN_VARETC" -a -d "$TOPGEN_CERTS" ] || {
   echo "
 ERROR: file \"$TOPGEN_ORIG\" and
@@ -98,6 +116,10 @@ $USAGE_BLURB
   exit 1
 }
 
+# scrape (unless asked to use the vhosts already present):
+shopt -s extglob # (used below; must be set before bash parses the if block)
+if [ "$NO_FETCH" == "no" ]; then
+
 # assert target folder is empty:
 [ -n "$(ls -A $TOPGEN_VHOSTS)" ] && {
   echo "
@@ -123,7 +145,6 @@ grep -v '^#' "$TOPGEN_ORIG" | while read URL DEPTH; do
 done
 
 # cleanup; remove IP-only vhosts, and vhosts ending with a ":<port-number>":
-shopt -s extglob
 rm -rf $TOPGEN_VHOSTS/+([[:digit:].]) $TOPGEN_VHOSTS/*:*
 
 # "curate" remaining vhosts; handle [www.]example.org/index.html issue:
@@ -139,17 +160,23 @@ for VH in $TOPGEN_VHOSTS/*; do
   fi
 done
 
+fi # NO_FETCH
+
 # topgen.info is reserved, be sure to create it completely from scratch:
 rm -rf "$TOPGEN_SITE"
 mkdir "$TOPGEN_SITE"
 
 # intersection of scraped vhosts in $TOPGEN_VHOSTS against $TOPGEN_ORIG
 # (NOTE: sed strips " DEPTH", "http://", and "/path/..." from each line)
+# (or, if not scraping, all vhosts other than topgen.info)
+if [ "$NO_FETCH" == "yes" ]; then
+  ls -1 $TOPGEN_VHOSTS | grep -vx topgen.info
+else
 comm -12 <(ls -1 $TOPGEN_VHOSTS) \
          <(grep -v '^#' "$TOPGEN_ORIG" | \
            sed -e 's|[[:space:]].*||; s|^.*//||; s|/.*$||' | \
-           sort -u) \
-  > "$TOPGEN_SITE/orig_vhosts.txt"
+           sort -u)
+fi > "$TOPGEN_SITE/orig_vhosts.txt"
 
 # generate topgen.info landing page (index.html):
 {
@@ -230,8 +257,9 @@ for VH in $TOPGEN_VHOSTS/*; do
 	}
 	EOT
 
-  # resolve vhost DNS IP address, write to hosts.nginx
-  VHIP=$(getent ahostsv4 $VB | head -1 | cut -d' ' -f1)
+  # resolve vhost IP address (preset, or via DNS), write to hosts.nginx
+  VHIP=$(awk -v h=$VB '$2 == h {print $1; exit}' <<< "$PRESET_HOSTS")
+  [ -n "$VHIP" ] || VHIP=$(getent ahostsv4 $VB | head -1 | cut -d' ' -f1)
   # use made-up IP '1.1.1.1' for unresolvable vhosts:
   echo "${VHIP:-1.1.1.1} $VB" >> "$TOPGEN_VARETC/hosts.nginx"
 done
