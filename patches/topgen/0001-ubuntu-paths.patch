diff --git a/sbin/topgen-mkdns.sh b/sbin/topgen-mkdns.sh
index a2b007d..1eebebe 100755
--- a/sbin/topgen-mkdns.sh
+++ b/sbin/topgen-mkdns.sh
@@ -370,10 +370,10 @@ options {
 	allow-query { any; };
 	recursion no;
 	check-names master ignore;
-	directory "/var/named";
-	dump-file "/var/named/data/cache_dump.db";
-	statistics-file "/var/named/data/named_stats.txt";
-	memstatistics-file "/var/named/data/named_mem_stats.txt";
+	directory "/var/cache/bind";
+	dump-file "/var/cache/bind/data/cache_dump.db";
+	statistics-file "/var/cache/bind/data/named_stats.txt";
+	memstatistics-file "/var/cache/bind/data/named_mem_stats.txt";
 	pid-file "/run/named/named.pid";
 	session-keyfile "/run/named/session.key";
 };
@@ -394,7 +394,7 @@ view "caching" {
 
 	zone "." IN {
 		type hint;
-		file "named.ca";
+		file "/usr/share/dns/root.hints";
 	};
 };
 
@@ -613,5 +613,7 @@ Required next steps may include:
 
 # FIXME: Sort out SELinux policy associated with topgen package !!!
 # But, for now, let's label the relevant files for use by named:
-chcon -t named_conf_t $NAMED_CONF
-chcon -R -t named_zone_t $NAMED_ZD/*
+if command -v selinuxenabled >/dev/null && selinuxenabled; then
+  chcon -t named_conf_t $NAMED_CONF
+  chcon -R -t named_zone_t $NAMED_ZD/*
+fi
diff --git a/sbin/topgen-scrape.sh b/sbin/topgen-scrape.sh
index 00bcf8b..e367ce3 100755
--- a/sbin/topgen-scrape.sh
+++ b/sbin/topgen-scrape.sh
@@ -244,7 +244,7 @@ authorityKeyIdentifier = keyid,issuer:always
 # (NOTE: using [alt_names] to work around CN length limit for long hostnames)
 TMP_VH_CONF=$(sed -e '/req_extensions/s/^# //;
                       /^\[ v3_req \]/a subjectAltName = @alt_names' \
-                  /etc/pki/tls/openssl.cnf)
+                  /etc/ssl/openssl.cnf)
 
 # start nginx.conf here (vhost entries to be appended from loop below)
 cat > "$TOPGEN_VARETC/nginx.conf" <<- EOT
diff --git a/sbin/topgen-tor.sh b/sbin/topgen-tor.sh
index fbb4507..6b91c81 100755
--- a/sbin/topgen-tor.sh
+++ b/sbin/topgen-tor.sh
@@ -216,8 +216,10 @@ sed -i "/Below is a list of Web sites/i $TDA_PARA" "$TG_INDEX"
 
 # FIXME: Sort out SELinux policy associated with topgen package !!!
 # But, for now, let's label the relevant files and folders manually:
-chcon -R -t tor_etc_t "$TOR_CFG"
-# also, allow DA binding to ports 5000 and 7000:
-setsebool -P tor_bind_all_unreserved_ports 1
+if command -v selinuxenabled >/dev/null && selinuxenabled; then
+  chcon -R -t tor_etc_t "$TOR_CFG"
+  # also, allow DA binding to ports 5000 and 7000:
+  setsebool -P tor_bind_all_unreserved_ports 1
+fi
 
 echo "Success!!!"
