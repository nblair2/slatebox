postfix: set compatibility_level = 2 in the generated main.cf, as Fedora's
stock main.cf does. At the built-in level 0 smtpd exits at startup
("specify at least one working instance of: reject_unauth_destination...").

--- a/sbin/topgen-vmail.sh	2026-11-08 19:36:25.936145999 +0000
+++ b/sbin/topgen-vmail.sh	2026-11-08 19:36:25.937794918 +0000
@@ -200,6 +200,9 @@
 	data_directory = /var/lib/postfix
 	queue_directory = /var/spool/postfix
 	mail_spool_directory = /var/spool/mail
+	# Fedora sets this in its stock main.cf; without it postfix 3.x runs with
+	# level 0 defaults and smtpd refuses to start (no relay restrictions):
+	compatibility_level = 2
 
 	# virtual multi-domain mailserver setup:
 	#
