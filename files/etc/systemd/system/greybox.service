[Unit]
Description=Greybox CORE session (/etc/greybox/map.xml)
Requires=core-daemon.service
After=core-daemon.service network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/greybox-ctl start
ExecStop=/usr/local/sbin/greybox-ctl stop
# 69 routers take minutes to boot
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
