[Unit]
Description=Greybox CORE session (/etc/greybox/map.xml)
Requires=core-daemon.service
After=core-daemon.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/greybox-ctl start
ExecStop=/usr/sbin/greybox-ctl stop
# 69 routers take minutes to boot (much longer under TCG)
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
